# Supabase project for MKule News. This is the News section's own project — it shares no
# database, no tables and no keys with MKuLayout.
#
# Only the PUBLISHABLE key belongs here. A secret/service key bypasses row-level security,
# and every VITE_ variable is compiled into the public bundle.
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_…"

# Shortform Input -> Google Sheets: URL of an Apps Script Web App (deploy > New deployment
# > Web app, executed as you, access "Anyone") that appends a row per synced entry.
# See syncShortformToSheets() in src/lib/workflow.ts for the exact payload the script
# receives: {"row":[writer,date,topic,link]}.
VITE_SHORTFORM_APPS_SCRIPT_URL=""

# Where a finished article is handed off: the MKuLayout site a Layout Deputy uses to
# confirm the request as an online pub task.
VITE_MKULAYOUT_URL="https://mkulayout.vercel.app"

# Google sign-in is handled by Supabase Auth (schema.sql + README cover the dashboard side),
# so this app needs no Google OAuth client ID of its own.
