# Google Sign-In: OAuth 2.0 Client ID of type "Web application".
# Add every origin this site is served from to the client's Authorized JavaScript
# origins (http://localhost:5173 for local runs, and the deployed https origin).
# Without it the app shows a "sign-in not configured" screen instead of the Google button.
VITE_GOOGLE_CLIENT_ID=""

# Shortform Input -> Google Sheets: URL of an Apps Script Web App (deploy > New deployment
# > Web app, executed as you, access "Anyone") that appends a row per synced entry.
# VITE_SHORTFORM_APPS_SCRIPT_URL="" — see syncShortformToSheets() in src/lib/workflow.ts
# for the exact payload the script receives: {"row":[writer,date,topic,link]}.
VITE_SHORTFORM_APPS_SCRIPT_URL=""

# Where a finished article is handed off: the MKuLayout site a Layout Deputy uses to
# confirm the request as an online pub task.
VITE_MKULAYOUT_URL="https://mkulayout.vercel.app"
